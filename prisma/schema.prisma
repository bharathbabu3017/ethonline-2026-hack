// PayGate data model.
//
// Privy owns approval state — which quorum signed what, and whether an intent
// met its threshold. This database owns what Privy has no idea about: invoices,
// memos, payee labels, roles, and the audit trail.
//
// Money is always integer micro-USDC (BigInt). Format only at the display edge.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Org {
  id       String @id @default(cuid())
  name     String

  // Privy object IDs, all created together at org setup.
  privyOrgId       String @unique
  privyWalletId    String
  walletAddress    String // the treasury
  approverQuorumId String // default_key_quorum_id, threshold 2
  memberQuorumId   String // additional_signer, threshold 1
  memberPolicyId   String // caps what the Members quorum may authorize

  // Payments at or below this clear on one signature. Above it, the Approvers
  // quorum must sign. Mirrored into memberPolicyId's rule; changing one without
  // the other silently breaks the guarantee.
  thresholdMicros BigInt @default(500000000) // $500.00

  /// Signatures the owner quorum requires. Mirrors the Privy key quorum that
  /// owns the treasury; changing one without the other breaks wallet updates.
  ownerThreshold Int @default(2)

  members   Member[]
  requests  PaymentRequest[]
  groups    ApprovalGroup[]
  changes   WalletChange[]
  events    AuditEvent[]
  createdAt DateTime @default(now())
}

/// A named approval rule: who may approve, and how many of them are needed.
///
/// Each group is backed by its own Privy key quorum and its own policy, attached
/// to the treasury wallet as an additional signer. Privy evaluates only the
/// policy of the signer that authorizes a transaction, so different groups can
/// carry genuinely different spending limits on one shared wallet.
model ApprovalGroup {
  id    String @id @default(cuid())
  orgId String
  org   Org    @relation(fields: [orgId], references: [id], onDelete: Cascade)

  name        String // "Grants", "Engineering", "Standard payments"
  description String?

  privyQuorumId String // key quorum holding this group's approvers
  privyPolicyId String? // spending cap applied when this group authorizes
  attachedToWallet Boolean @default(false) // whether Privy has it as a signer

  /// Signatures required before a payment assigned to this group may settle.
  threshold Int @default(1)

  /// Largest payment this group may release, in micro-USDC. Null means no cap.
  maxAmountMicros BigInt?

  /// Used when a payment does not name a group, and as the fallback that must
  /// always exist so an org can never be left unable to pay.
  isDefault Boolean @default(false)

  members  ApprovalGroupMember[]
  requests PaymentRequest[]
  changes  WalletChange[]

  createdAt DateTime @default(now())

  @@unique([orgId, name])
  @@index([orgId])
}

/// A pending change to the treasury wallet's configuration.
///
/// Attaching an approval group as a signer is an owner-level action: Privy
/// requires signatures meeting the owner quorum's threshold, the same bar as a
/// large payment. Changing who may spend is at least as sensitive as spending,
/// so the same two-person rule applies.
model WalletChange {
  id    String @id @default(cuid())
  orgId String
  org   Org    @relation(fields: [orgId], references: [id], onDelete: Cascade)

  type        String // ATTACH_GROUP
  description String

  groupId String?
  group   ApprovalGroup? @relation(fields: [groupId], references: [id], onDelete: Cascade)

  /// The exact wallet update every approver signs, fixed when the change is
  /// proposed so each signature covers identical bytes.
  requestBody String

  status        String  @default("PENDING") // PENDING | APPLIED | FAILED | REJECTED
  failureReason String?

  createdById String
  approvals   WalletChangeApproval[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orgId, status])
}

model WalletChangeApproval {
  changeId String
  change   WalletChange @relation(fields: [changeId], references: [id], onDelete: Cascade)
  memberId String
  member   Member       @relation(fields: [memberId], references: [id], onDelete: Cascade)

  signature String
  createdAt DateTime @default(now())

  @@id([changeId, memberId])
}

model ApprovalGroupMember {
  groupId  String
  group    ApprovalGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  memberId String
  member   Member        @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@id([groupId, memberId])
  @@index([memberId])
}

model Member {
  id    String @id @default(cuid())
  orgId String
  org   Org    @relation(fields: [orgId], references: [id], onDelete: Cascade)

  privyUserId   String  @unique
  email         String
  name          String
  walletAddress String? // personal embedded wallet, used when paying a member
  role          String // ADMIN | APPROVER | MEMBER

  // P-256 authorization keypair registered in this org's key quorums.
  //
  // DEMO-GRADE: Privy cannot currently issue user signing keys for this app
  // (POST /v1/wallets/authenticate rejects valid access tokens), so approvals
  // are signed with platform-held keys instead of keys held by each approver.
  // Privy still enforces the quorum threshold and the spending policy, but a
  // compromised backend could forge an approval — which browser-held user keys
  // would prevent. Swap back to user signers when Privy enables them.
  authPublicKey  String?
  authPrivateKey String?

  requested PaymentRequest[]     @relation("Requester")
  paidTo    PaymentRequest[]     @relation("PayeeMember")
  approvals Approval[]
  groups    ApprovalGroupMember[]
  changeApprovals WalletChangeApproval[]
  createdAt DateTime         @default(now())

  @@unique([orgId, email])
  @@index([orgId])
}

model PaymentRequest {
  id    String @id @default(cuid())
  orgId String
  org   Org    @relation(fields: [orgId], references: [id], onDelete: Cascade)

  requesterId String
  requester   Member @relation("Requester", fields: [requesterId], references: [id])

  payeeType     String // ADDRESS | MEMBER
  payeeAddress  String // resolved at submit time so history stays immutable
  payeeMemberId String?
  payeeMember   Member? @relation("PayeeMember", fields: [payeeMemberId], references: [id])
  payeeLabel    String

  amountMicros BigInt
  memo         String

  route         String  @default("AUTO") // AUTO | QUORUM, kept for older rows

  /// The approval rule this payment must satisfy. Null for payments created
  /// before groups existed, which fall back to the org threshold.
  groupId       String?
  group         ApprovalGroup? @relation(fields: [groupId], references: [id])
  privyIntentId String? @unique // unused; retained to avoid a destructive migration
  // The exact transaction every approver signs, fixed at submit time so each
  // signature covers identical bytes. Submitted to Privy with the collected
  // signatures once the approval threshold is met. Optional only so payments
  // created before this path existed still load.
  requestBody   String?
  status        String  @default("PENDING") // PENDING PROCESSING EXECUTED FAILED REJECTED EXPIRED
  txHash        String?
  failureReason String?

  invoices  Invoice[]
  approvals Approval[]
  events    AuditEvent[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([orgId, status])
}

model Invoice {
  id        String         @id @default(cuid())
  requestId String
  request   PaymentRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  filename     String // original name, for display only
  storagePath  String // generated name on disk; never user-controlled
  mimeType     String
  sizeBytes    Int
  uploadedById String
  createdAt    DateTime @default(now())

  @@index([requestId])
}

model Approval {
  id        String         @id @default(cuid())
  requestId String
  request   PaymentRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  memberId  String
  member    Member         @relation(fields: [memberId], references: [id])

  kind      String // AUTHORIZED | REJECTED
  // The approver's authorization signature over the payment's requestBody.
  // Held until enough are collected, then submitted to Privy together.
  signature String?
  createdAt DateTime @default(now())

  // One vote per member per request. Privy is idempotent per signer anyway;
  // this keeps the UI from showing a double approval.
  @@unique([requestId, memberId])
}

model AuditEvent {
  id        String          @id @default(cuid())
  orgId     String
  org       Org             @relation(fields: [orgId], references: [id], onDelete: Cascade)
  requestId String?
  request   PaymentRequest? @relation(fields: [requestId], references: [id], onDelete: Cascade)
  actorId   String?

  // ORG_CREATED MEMBER_ADDED REQUEST_SUBMITTED INVOICE_UPLOADED
  // APPROVED REJECTED EXECUTED FAILED THRESHOLD_CHANGED
  type      String
  payload   String // JSON
  createdAt DateTime @default(now())

  @@index([orgId, createdAt])
}

# PayGate environment template.
#
#   cp .env.example .env.local
#
# then fill in the values below. .env.local is gitignored — never commit it,
# and never paste PRIVY_APP_SECRET into a chat, an issue, or a screenshot.

# ---------------------------------------------------------------------------
# Privy — https://dashboard.privy.io
# ---------------------------------------------------------------------------

# App ID. Not secret; it ships to the browser.
PRIVY_APP_ID=

# Same value as PRIVY_APP_ID. Next.js only exposes NEXT_PUBLIC_-prefixed vars
# to client components, and PrivyProvider needs it there.
NEXT_PUBLIC_PRIVY_APP_ID=

# App secret. SECRET — server-side only, never NEXT_PUBLIC_.
# Shown exactly once when you create it; if lost, rotate and update this file.
PRIVY_APP_SECRET=

# Signing secret for the Privy webhook endpoint (Phase 5).
# Leave blank until you register the endpoint in the dashboard.
PRIVY_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Arc testnet — USDC is the native gas token
# ---------------------------------------------------------------------------
# Chain ID 5042002 (CAIP-2: eip155:5042002)
# Explorer: https://testnet.arcscan.app
# Faucet:   https://faucet.circle.com
ARC_RPC_URL=https://rpc.testnet.arc.network

# ---------------------------------------------------------------------------
# Database — Postgres
# ---------------------------------------------------------------------------
# On Vercel this is set automatically by the Neon integration. Locally, paste
# the same connection string so dev and production share a database, or point
# at your own Postgres.
DATABASE_URL=

# Settlement chain: base-sepolia | arc-testnet (see src/lib/chain.ts)
NEXT_PUBLIC_CHAIN=base-sepolia
